# memory-system environment template.
# Copy to .env and fill in. Defaults below are the local API-key happy path.

# --- Embedding + database (API-key happy path) ---
DATABASE_URL=postgres://memory:memory@localhost:5432/memory?sslmode=disable
EMBEDDING_PROVIDER=ollama
EMBEDDING_DIMENSIONS=768
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=nomic-embed-text

# --- OAuth 2.1 / OIDC (optional) ---

# Set the Google client id and secret together to enable the OAuth path.
# MEMORY_MCP_GOOGLE_CLIENT_ID=your-google-oauth-client-id
# MEMORY_MCP_GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# PUBLIC_BASE_URL is required once OAuth is on: absolute http(s) origin, no path.
# PUBLIC_BASE_URL=https://mem.example.org

# AUTHLET_MASTER_KEY seals OAuth signing keys at rest (32-byte hex).
# AUTHLET_MASTER_KEY=00000000000000000000000000000000

# MEMORY_UI_CLIENT_ID is the public PKCE client id used by the web console.
# MEMORY_UI_CLIENT_ID=your-public-pkce-client-id

# --- Signup domain gate (optional) ---
# Unset means any verified identity can self-provision; set to lock signup to your org.
# SIGNUP_ALLOWED_DOMAINS=example.com,corp.example.com
